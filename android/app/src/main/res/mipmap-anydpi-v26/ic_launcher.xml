<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ composes the launcher icon from these two layers and applies the
     launcher's own mask (circle, squircle, teardrop). The foreground therefore
     keeps the BMA mark well inside the 72dp safe zone; see tool/make_icons.py
     for the arithmetic. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
